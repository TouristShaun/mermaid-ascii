# Multi-stage build for the Forge server.
FROM golang:1.21-alpine AS builder

RUN apk add --no-cache git gcc musl-dev sqlite-dev

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=1 go build -o /forge ./forge/cmd/forged

# Runtime image.
FROM alpine:3.19

RUN apk add --no-cache git sqlite ca-certificates

COPY --from=builder /forge /usr/local/bin/forge

EXPOSE 8420

ENTRYPOINT ["forge"]
CMD ["--addr", ":8420", "--data", "/var/lib/forge"]
